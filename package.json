{
  "name": "portfolio-tracker",
  "version": "1.0.0",
  "description": "Simple portfolio tracking application",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "build:netlify": "npm run install-deps && npm run setup-python && npm run build",
    "install-deps": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../shared/utils && pip install -r requirements.txt",
    "setup-python": "cd shared/utils && pip install -r requirements.txt",
    "postinstall": "npm run install-deps"
  },
  "dependencies": {
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "portfolio",
    "tracking",
    "stocks",
    "finance",
    "investment"
  ],
  "author": "",
  "license": "ISC"
}
